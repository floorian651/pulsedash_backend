# ============================================================
# PulseDash Backend — Environment variables
# Copier ce fichier en .env et remplir les valeurs
# ============================================================
# Génération des secrets : openssl rand -hex 32  (ou 64 pour JWT)
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME="PulseDash API"
DEBUG=false

# ------------------------------------------------------------
# PostgreSQL
# En prod (podman-compose) : POSTGRES_HOST=db
# En dev local             : POSTGRES_HOST=localhost
# ------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=pulsedash
POSTGRES_PASSWORD=changeme                  # openssl rand -hex 32
POSTGRES_DB=pulsedash

# ------------------------------------------------------------
# MinIO
# En prod (podman-compose) : MINIO_ENDPOINT=minio:9000
# En dev local             : MINIO_ENDPOINT=localhost:9000
# ------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=pulsedash
MINIO_SECRET_KEY=changeme                   # openssl rand -hex 32
MINIO_SECURE=false
MINIO_ROOT_USER=pulsedash
MINIO_ROOT_PASSWORD=changeme                # openssl rand -hex 32
MINIO_BUCKET_MUSIC=music
MINIO_BUCKET_LEVELS=levels
# MINIO_PUBLIC_ENDPOINT=https://minio.example.com  # optionnel : URL publique pour les URLs de téléchargement

# ------------------------------------------------------------
# Redis / Celery
# En prod (podman-compose) : REDIS_HOST=redis
# En dev local             : REDIS_HOST=localhost
# REDIS_DB                : base utilisée par Celery
# REDIS_BLACKLIST_DB : base utilisée pour la blacklist JWT (séparée)
# ------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_BLACKLIST_DB=1

# ------------------------------------------------------------
# Jamendo API
# Obtenir un client ID : https://devportal.jamendo.com
# ------------------------------------------------------------
JAMENDO_CLIENT_ID=your_jamendo_client_id

# ------------------------------------------------------------
# Sécurité / JWT
# JWT_SECRET_KEY : openssl rand -hex 64
# ------------------------------------------------------------
JWT_SECRET_KEY=changeme_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ------------------------------------------------------------
# CORS
# En prod : mettre le domaine exact (ex: https://app.example.com)
# En dev  : * est acceptable
# ------------------------------------------------------------
CORS_ORIGINS=*

# ------------------------------------------------------------
# Cloudflare Tunnel
# Créer le tunnel sur https://one.dash.cloudflare.com
# Zero Trust → Networks → Tunnels → Create tunnel
# ------------------------------------------------------------
TUNNEL_TOKEN=your_cloudflare_tunnel_token
